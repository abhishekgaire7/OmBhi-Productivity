# GEMINI_API_KEY: API key for Gemini AI features (Daily Planner, Natural Language Task Parsing, AI Coach, and Weekly Review).
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The public base URL where the OmBhi application is hosted.
APP_URL="https://example.com"

# FIREBASE_SERVICE_ACCOUNT_JSON: Service Account private key credentials for Firebase Admin SDK.
# Can be provided as either:
# 1) A minified single-line JSON string: '{"type":"service_account","project_id":"...","private_key":"..."}'
# 2) A path to a local service account JSON file (e.g., ./service-account.json)
# If omitted in environments with Google Cloud Application Default Credentials (ADC), ADC will be used.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# FIREBASE_PROJECT_ID: (Optional) Override or explicitly specify the Firebase Project ID.
FIREBASE_PROJECT_ID=""

